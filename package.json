{
  "name": "chroma-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs start",
    "lint": "eslint src",
    "wallets:catalog": "node scripts/build-wallet-catalog.mjs",
    "tokens:icons": "node scripts/build-token-icons.mjs",
    "logo": "node scripts/prepare-logo.mjs",
    "test:fees": "node scripts/test-fees.mjs",
    "test:nickname": "node scripts/test-nickname.mjs",
    "test:affiliate": "node scripts/test-affiliate-dashboard.mjs",
    "test:photo": "node scripts/test-profile-photo.mjs",
    "test:multichain": "node scripts/test-multichain.mjs",
    "test:token-media": "node scripts/test-token-media.mjs",
    "test:curve": "node scripts/test-curve-math.mjs",
    "lint:strict": "eslint src --max-warnings=0",
    "test:programa": "node scripts/test-programa.mjs",
    "localnet": "wsl -d Ubuntu -e bash \"$(wslpath -a ./scripts/validador.sh)\"",
    "test:lancamento": "node scripts/test-lancamento.mjs",
    "contracts:build": "wsl -d Ubuntu -e bash -lc \"export PATH=$PATH:/home/chroma/.foundry/bin && cd /mnt/c/Users/User/Desktop/chroma-app/contracts && forge build\"",
    "contracts:test": "wsl -d Ubuntu -e bash -lc \"export PATH=$PATH:/home/chroma/.foundry/bin && cd /mnt/c/Users/User/Desktop/chroma-app/contracts && forge test -vv\"",
    "rust:test": "wsl -d Ubuntu -e bash -lc \"export PATH=$HOME/.cargo/bin:$PATH && export CARGO_TARGET_DIR=$HOME/chroma-target && cd /mnt/c/Users/User/Desktop/chroma-app && cargo test -p chroma-curve\"",
    "rust:build": "wsl -d Ubuntu -e bash -lc \"export PATH=$HOME/.cargo/bin:$PATH && export CARGO_TARGET_DIR=$HOME/chroma-target && cd /mnt/c/Users/User/Desktop/chroma-app && cargo check -p chroma-curve\"",
    "test:migracao": "node scripts/test-migracao.mjs",
    "paridade": "node scripts/gerar-paridade.mjs",
    "test:recados": "node scripts/test-recados.mjs",
    "test:indicacao": "node scripts/test-indicacao.mjs",
    "test:vinculo": "node scripts/test-vinculo.mjs",
    "devnet:config": "node scripts/configurar-devnet.mjs",
    "devnet:deploy": "wsl -d Ubuntu -e bash -lc \"export PATH=$HOME/.cargo/bin:$HOME/.local/share/solana/install/active_release/bin:$PATH && cd /mnt/c/Users/User/Desktop/chroma-app && anchor deploy --provider.cluster devnet\"",
    "test:abi": "node scripts/test-abi-evm.mjs"
  },
  "dependencies": {
    "@cloak.dev/sdk": "^0.2.5",
    "@meteora-ag/cp-amm-sdk": "^1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.13",
    "@neondatabase/serverless": "^1.1.0",
    "@pump-fun/pump-sdk": "^2.0.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/web3.js": "^1.95.3",
    "@tanstack/react-query": "^5.59.0",
    "@vercel/blob": "^2.8.0",
    "bn.js": "^5.2.5",
    "clsx": "^2.1.1",
    "klinecharts": "^9.8.12",
    "next": "^16.3.5",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.2",
    "viem": "^2.56.8",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "cryptocurrency-icons": "^0.18.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.4.47",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
