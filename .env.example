# ===============================================================
# OBRIGATÓRIO PRO SWAP FUNCIONAR (Solana)
# ===============================================================

# RPC dedicado da Solana. O endpoint público responde 403 pro navegador:
# sem isto, gráfico e cotação funcionam mas ENVIAR transação falha.
# Plano gratuito da Helius resolve: https://helius.dev
NEXT_PUBLIC_SOLANA_RPC=

# Carteira que recebe a parte da plataforma (0,5%, ou 1% sem afiliado).
# Sem ela o swap é bloqueado de propósito.
NEXT_PUBLIC_PLATFORM_FEE_WALLET_SOL=

# ===============================================================
# ROBINHOOD CHAIN (chain id 4663)
# ===============================================================

# O RPC público não tem SLA. Para produção a Robinhood recomenda Alchemy.
NEXT_PUBLIC_ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com

# Carteira da plataforma nas redes EVM (o swap EVM ainda não está ligado).
NEXT_PUBLIC_PLATFORM_FEE_WALLET_EVM=

# ===============================================================
# LOGIN COM GOOGLE (opcional, ainda não implementado)
# ===============================================================

# Exige um provedor de embedded wallet: privy | web3auth | dynamic | turnkey.
# Ver src/lib/social-login.ts antes de preencher.
NEXT_PUBLIC_SOCIAL_LOGIN_PROVIDER=
NEXT_PUBLIC_SOCIAL_LOGIN_KEY=

# ===============================================================
# OPCIONAL
# ===============================================================

# Indexador próprio de velas. Vazio = GeckoTerminal (padrão).
NEXT_PUBLIC_CANDLES_API=

# Quick Intel, pra somar à auditoria da GoPlus (que funciona sem chave)
QUICKINTEL_API_KEY=

# ===============================================================
# TAXA DE LANÇAMENTO
# ===============================================================
# Cobrada no envio do formulário. Vazio/0 = lançamento grátis.
# O valor não vinha nas telas de referência, então precisa ser decidido.
NEXT_PUBLIC_LAUNCH_FEE_SOL=
NEXT_PUBLIC_LAUNCH_FEE_ETH=

# ---------------------------------------------------------------------------
# Curva de bonding (lançamento de moedas)
# ---------------------------------------------------------------------------

# Endereço do programa on-chain. O padrão é o da rede local.
NEXT_PUBLIC_CHROMA_PROGRAM_ID=2uAzEJEhVdEsk3DVMrkrcnHCmoFicmg8QPk7xKw8uqB4

# Para TESTAR O LANÇAMENTO, aponte o site pra rede local:
#
#   NEXT_PUBLIC_SOLANA_RPC=http://localhost:8899
#
# Suba a rede antes com `npm run localnet`.
#
# Atenção: na rede local não existem as moedas de mercado (a Dexscreener
# indexa a mainnet), então a home e os gráficos ficam vazios. É esperado —
# são dois mundos diferentes, e misturar os dois daria números falsos.
