# Nenhum pacote executa script na instalação.
#
# É o caminho por onde as invasões de cadeia de suprimentos entram: alguém
# compromete a conta de um mantenedor, publica uma versão com `postinstall`, e
# esse script roda com as suas permissões na hora do `npm install` — antes de
# qualquer pessoa ler uma linha do código novo. Foi assim em praticamente todos
# os casos grandes que drenaram carteira de usuário de site de cripto.
#
# Bloquear tem um custo: pacote que compila binário nativo precisa de
# aprovação explícita (`npm approve-scripts`). Hoje nenhum aqui precisa.
ignore-scripts=true

# Nada de instalar versão nova sem passar pelo package-lock.
# `npm ci` em vez de `npm install` no deploy garante o mesmo conteúdo exato.
save-exact=false
audit-level=high
